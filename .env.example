# Modo Demostración (opcional: "true" o "false")
# Cuando es "true", la aplicación muestra una franja superior de demostración,
# desactiva la opción de eliminar inmuebles y opera siempre con el motor
# heurístico local sin pedir ni enviar claves de OpenRouter.
NEXT_PUBLIC_DEMO_MODE=false

# Clave de OpenRouter (opcional a nivel de servidor).
# Puede dejarse vacía; cada asesor puede configurar su clave en la interfaz o usar el motor local gratuito.
OPENROUTER_API_KEY=
